# Copy to .env and fill in. Never commit .env.

# Local Postgres (dev). In production use Neon's pooled URL here and the
# unpooled one in DIRECT_URL (used only by prisma migrate / seed).
DATABASE_URL="postgresql://finance:finance@localhost:5432/finance"
# DIRECT_URL=""
TEST_DATABASE_URL="postgresql://finance:finance@localhost:5432/finance_test"

# Auth.js — generate AUTH_SECRET with `npx auth secret`
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# The only e-mail allowed to sign in
ALLOWED_EMAIL=""

# Gemini free tier (optional). AI_ENABLED=false keeps every AI path off.
AI_ENABLED="false"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash-lite"
